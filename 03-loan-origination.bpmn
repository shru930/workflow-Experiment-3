<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_loan-origination" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_loan-origination">
    <bpmn:participant id="Participant_Main" name="Bank — Retail Lending" processRef="loan-origination" />
    <bpmn:participant id="Participant_Applicant" name="Applicant">
      <bpmn:documentation>The customer applying for the loan.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_Bureau" name="Credit Bureau">
      <bpmn:documentation>External credit bureau queried for the credit report and score.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="MsgFlow_App" name="Application" sourceRef="Participant_Applicant" targetRef="Start_Application" />
    <bpmn:messageFlow id="MsgFlow_DocReq" name="Missing items" sourceRef="Task_RequestDocs" targetRef="Participant_Applicant" />
    <bpmn:messageFlow id="MsgFlow_Docs" name="Documents" sourceRef="Participant_Applicant" targetRef="Task_AwaitDocs" />
    <bpmn:messageFlow id="MsgFlow_Withdraw" name="Withdrawal" sourceRef="Participant_Applicant" targetRef="Start_Withdraw" />
    <bpmn:messageFlow id="MsgFlow_Offer" name="Offer letter" sourceRef="Task_SendOffer" targetRef="Participant_Applicant" />
    <bpmn:messageFlow id="MsgFlow_Accept" name="Acceptance" sourceRef="Participant_Applicant" targetRef="Task_AwaitAcceptance" />
    <bpmn:messageFlow id="MsgFlow_Agreement" name="Agreement" sourceRef="Task_SendAgreement" targetRef="Participant_Applicant" />
    <bpmn:messageFlow id="MsgFlow_Signed" name="Signed agreement" sourceRef="Participant_Applicant" targetRef="Task_AwaitSignature" />
    <bpmn:messageFlow id="MsgFlow_BureauReq" name="Report request" sourceRef="Task_CreditScore" targetRef="Participant_Bureau" />
    <bpmn:messageFlow id="MsgFlow_BureauResp" name="Credit report" sourceRef="Participant_Bureau" targetRef="Task_CreditScore" />
  </bpmn:collaboration>
  <bpmn:process id="loan-origination" name="Loan Origination and Approval" isExecutable="true">
    <bpmn:documentation>Personal and secured loan applications from submission to disbursement. Shows the normal approval flow and every point where an application can stall, be rejected, be withdrawn or lapse (L1–L12).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_Officer" name="Loan Officer">
        <bpmn:documentation>Owns the applicant relationship: document requests, manual checks, offers and signatures.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_Application</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DocsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_DocsTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualKYC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyIncome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Restructure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_OfferExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_OfferDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfferExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfferDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SignMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAgreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitSignature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_SignTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Withdrawal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Core Banking System">
        <bpmn:documentation>Automated checks, scoring, offer generation, account creation and notifications.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_CheckDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DocsComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectFee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_FeeComp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefundFee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_VerifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KYC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_KycMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_KycMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FraudScreen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreditScore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_BureauDown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CreditMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_VerifyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_VerifyOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ScoreMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Score</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RiskDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CounterMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RestructuredBefore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RejectMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_OfferMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifySignature</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SignValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SignFailMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SignRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfferCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_AccountComp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyDisbursed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Disbursed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriting" name="Underwriter / Credit Committee">
        <bpmn:documentation>Credit judgement, additional checks and high-value approvals.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_ManualCredit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ChecksSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Collateral</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Guarantor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EDD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ChecksJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Underwrite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_UwDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Committee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_CommitteeSla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EscalateCCO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SlaEscalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CommitteeDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Compliance" name="Fraud &amp; Compliance Team">
        <bpmn:documentation>Investigates fraud, AML and sanctions flags.</bpmn:documentation>
        <bpmn:flowNodeRef>Sub_Investigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_Fraud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Freeze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Terminated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operations" name="Operations / Disbursement">
        <bpmn:documentation>Beneficiary verification and payout.</bpmn:documentation>
        <bpmn:flowNodeRef>Gw_AcctMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyBeneficiary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AcctValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disburse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_PaymentFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_HoldMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldContact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Resolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_ReverseAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DisbursementFailed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Application" name="Application received">
      <bpmn:documentation>Message start: applicant submits the application form and supporting documents.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Application_messageDef" messageRef="Msg_Application" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_DocsMerge">
      <bpmn:documentation>Merge: first submission and resubmitted documents.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_CheckDocs" name="Check document completeness">
      <bpmn:documentation>Rules list the documents required for this product (ID, address proof, income proof, collateral papers for secured loans) and check legibility flags from the OCR step.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-document-completeness" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_DocsComplete" name="Documents complete?" default="Flow_DocsNo">
      <bpmn:documentation>L1 — exclusive: complete, or not (default).</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_DocsYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DocsNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestDocs" name="Request missing documents">
      <bpmn:documentation>L1 — sends the applicant the list of missing / illegible items.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-missing-documents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DocsNo</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_AwaitDocs" name="Await documents" messageRef="Msg_Documents">
      <bpmn:documentation>L1 — waits for the resubmission.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Bnd_DocsTimeout" name="No response in 7 days" cancelActivity="true" attachedToRef="Task_AwaitDocs">
      <bpmn:documentation>L1 — interrupting timer.</bpmn:documentation>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Bnd_DocsTimeout_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Lapsed" name="Application lapsed">
      <bpmn:documentation>Terminal: documents never provided.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CollectFee" name="Collect processing fee">
      <bpmn:documentation>Debits the processing fee.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="collect-processing-fee" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DocsYes</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_FeeComp" name="Undo fee" cancelActivity="true" attachedToRef="Task_CollectFee">
      <bpmn:documentation>Compensation boundary for the fee.</bpmn:documentation>
      <bpmn:compensateEventDefinition id="Bnd_FeeComp_compensateDef" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_RefundFee" name="Refund processing fee" isForCompensation="true">
      <bpmn:documentation>Compensation handler: reverses the fee.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="refund-processing-fee" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_VerifySplit">
      <bpmn:documentation>Parallel split: KYC, fraud screening, bureau score and income checks are independent and run together.</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_KYC" name="Verify identity (KYC)">
      <bpmn:documentation>Matches identity details against official records.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-kyc" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_KycMatch" name="Identity matches?" default="Flow_KycNo">
      <bpmn:documentation>L2 — exclusive: match, or mismatch (default).</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_KycYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_KycNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualKYC" name="Verify identity manually">
      <bpmn:documentation>L2 — officer checks originals / video-KYC and records kycResolved.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/verify-identity-manually" />
        <zeebe:assignmentDefinition candidateGroups="loan-officers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_KycNo</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_KycMerge">
      <bpmn:documentation>Merge: automatic or manual KYC.</bpmn:documentation>
      <bpmn:incoming>Flow_KycYes</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_FraudScreen" name="Screen fraud, AML and sanctions">
      <bpmn:documentation>L3 — document forensics, AML rules and sanctions-list lookup; sets complianceFlag.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="screen-fraud-aml" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CreditScore" name="Retrieve credit score">
      <bpmn:documentation>Requests the credit report from the bureau. Retries 3 times; after that the worker throws BUREAU_UNAVAILABLE.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="retrieve-credit-score" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_BureauDown" name="Bureau unavailable" cancelActivity="true" attachedToRef="Task_CreditScore">
      <bpmn:documentation>L4 — bureau API timed out on every retry.</bpmn:documentation>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Bnd_BureauDown_errorDef" errorRef="Err_BureauDown" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_ManualCredit" name="Perform manual credit assessment">
      <bpmn:documentation>L4 — fallback: credit analyst assesses bank statements and repayment history directly.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/perform-manual-credit-assessment" />
        <zeebe:assignmentDefinition candidateGroups="underwriters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_CreditMerge">
      <bpmn:documentation>Merge: bureau or manual score.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_VerifyIncome" name="Verify income and employment">
      <bpmn:documentation>Officer verifies salary slips / ITR and calls the employer.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/verify-income-and-employment" />
        <zeebe:assignmentDefinition candidateGroups="loan-officers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gw_VerifyJoin">
      <bpmn:documentation>Parallel join: all four checks must finish.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gw_VerifyOutcome" name="Verification outcome?" default="Flow_AllClear">
      <bpmn:documentation>Exclusive: compliance flag raised, identity still unresolved, or all clear (default).</bpmn:documentation>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_Flag</bpmn:outgoing>
      <bpmn:outgoing>Flow_IdUnresolved</bpmn:outgoing>
      <bpmn:outgoing>Flow_AllClear</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_Investigation" name="Compliance investigation">
      <bpmn:documentation>Embedded sub-process run by Fraud &amp; Compliance. Throws FRAUD_CONFIRMED when the flag is upheld.</bpmn:documentation>
      <bpmn:incoming>Flow_Flag</bpmn:incoming>
      <bpmn:outgoing>Flow_I4</bpmn:outgoing>
      <bpmn:startEvent id="Start_Inv" name="Flag received">
        <bpmn:documentation>Blank start.</bpmn:documentation>
        <bpmn:outgoing>Flow_I1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Task_Investigate" name="Investigate compliance flag">
        <bpmn:documentation>L3 — investigator reviews forged-document indicators, AML pattern or sanctions hit.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition externalReference="/forms/investigate-compliance-flag" />
          <zeebe:assignmentDefinition candidateGroups="compliance" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_I1</bpmn:incoming>
        <bpmn:outgoing>Flow_I2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gw_Confirmed" name="Fraud / AML confirmed?" default="Flow_ConfNo">
        <bpmn:documentation>L3 — exclusive: confirmed, or cleared (default).</bpmn:documentation>
        <bpmn:incoming>Flow_I2</bpmn:incoming>
        <bpmn:outgoing>Flow_ConfYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_ConfNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Cleared" name="Flag cleared">
        <bpmn:documentation>Sub-process completes; application continues.</bpmn:documentation>
        <bpmn:incoming>Flow_ConfNo</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Task_FileSAR" name="File suspicious-activity report">
        <bpmn:documentation>L3 — internal / regulatory report filed.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="file-sar" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ConfYes</bpmn:incoming>
        <bpmn:outgoing>Flow_I3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_FraudConfirmed" name="Fraud confirmed">
        <bpmn:documentation>Error end: throws FRAUD_CONFIRMED.</bpmn:documentation>
        <bpmn:incoming>Flow_I3</bpmn:incoming>
        <bpmn:errorEventDefinition id="End_FraudConfirmed_errorDef" errorRef="Err_FraudConfirmed" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_I1" sourceRef="Start_Inv" targetRef="Task_Investigate" />
      <bpmn:sequenceFlow id="Flow_I2" sourceRef="Task_Investigate" targetRef="Gw_Confirmed" />
      <bpmn:sequenceFlow id="Flow_ConfYes" name="Yes" sourceRef="Gw_Confirmed" targetRef="Task_FileSAR">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fraudConfirmed = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_ConfNo" name="No" sourceRef="Gw_Confirmed" targetRef="End_Cleared" />
      <bpmn:sequenceFlow id="Flow_I3" sourceRef="Task_FileSAR" targetRef="End_FraudConfirmed" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Bnd_Fraud" name="Fraud confirmed" cancelActivity="true" attachedToRef="Sub_Investigation">
      <bpmn:documentation>L3 — catches FRAUD_CONFIRMED.</bpmn:documentation>
      <bpmn:outgoing>Flow_I5</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Bnd_Fraud_errorDef" errorRef="Err_FraudConfirmed" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Freeze" name="Freeze customer and close file">
      <bpmn:documentation>L3 — blocks the customer record and closes the application.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="freeze-and-close" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_I5</bpmn:incoming>
      <bpmn:outgoing>Flow_I6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Terminated" name="Rejected — compliance">
      <bpmn:documentation>L3 — terminate end: kills every remaining token (including the withdrawal listener) immediately.</bpmn:documentation>
      <bpmn:incoming>Flow_I6</bpmn:incoming>
      <bpmn:terminateEventDefinition id="End_Terminated_terminateDef" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_ScoreMerge">
      <bpmn:documentation>Merge: all clear, flag cleared, or restructured terms to re-score.</bpmn:documentation>
      <bpmn:incoming>Flow_AllClear</bpmn:incoming>
      <bpmn:incoming>Flow_I4</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_Score" name="Score eligibility and risk">
      <bpmn:documentation>Decision table over credit score, debt-to-income, loan-to-value and amount: AUTO_APPROVE, MANUAL_REVIEW, COUNTER_OFFER or REJECT.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="score-application" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_RiskDecision" name="Risk decision?" default="Flow_Manual">
      <bpmn:documentation>Exclusive four-way split. Manual review is the default, so an unexpected result goes to a human, never to an automatic approval.</bpmn:documentation>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_AutoReject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Counter</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manual</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_CounterMerge">
      <bpmn:documentation>Merge: counter-offers from scoring and from the underwriter.</bpmn:documentation>
      <bpmn:incoming>Flow_Counter</bpmn:incoming>
      <bpmn:incoming>Flow_UwCounter</bpmn:incoming>
      <bpmn:outgoing>Flow_CounterMerged</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_RestructuredBefore" name="Already restructured?" default="Flow_RestructNo">
      <bpmn:documentation>L5 / L6 — bounded loop: terms are restructured at most once.</bpmn:documentation>
      <bpmn:incoming>Flow_CounterMerged</bpmn:incoming>
      <bpmn:outgoing>Flow_RestructYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_RestructNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Restructure" name="Propose restructured terms">
      <bpmn:documentation>L5 / L6 — officer agrees a smaller amount, longer tenure, guarantor or extra collateral with the applicant.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/propose-restructured-terms" />
        <zeebe:assignmentDefinition candidateGroups="loan-officers" />
        <zeebe:ioMapping>
          <zeebe:output source="=true" target="restructured" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RestructYes</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="Gw_ChecksSplit" name="Extra checks required?" default="Flow_ChkNone">
      <bpmn:documentation>L7 / L8 — inclusive split: any combination of checks applies; the default (none) is taken only when no condition holds.</bpmn:documentation>
      <bpmn:incoming>Flow_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_ChkCollateral</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChkGuarantor</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChkEDD</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChkNone</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="Task_Collateral" name="Value collateral and check title">
      <bpmn:documentation>L8 — secured loans only.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/value-collateral-and-check-title" />
        <zeebe:assignmentDefinition candidateGroups="valuers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ChkCollateral</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Guarantor" name="Verify guarantor">
      <bpmn:documentation>When a guarantor is part of the terms.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/verify-guarantor" />
        <zeebe:assignmentDefinition candidateGroups="underwriters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ChkGuarantor</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EDD" name="Enhanced due diligence">
      <bpmn:documentation>L7 — amount above the policy threshold.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/enhanced-due-diligence" />
        <zeebe:assignmentDefinition candidateGroups="underwriters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ChkEDD</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="Gw_ChecksJoin">
      <bpmn:documentation>Inclusive join: waits only for the checks actually started.</bpmn:documentation>
      <bpmn:incoming>Flow_ChkNone</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="Task_Underwrite" name="Underwrite application">
      <bpmn:documentation>Underwriter decides APPROVE, REJECT, COUNTER_OFFER (e.g. low valuation → lower LTV) or ESCALATE (above authority / borderline).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/underwrite-application" />
        <zeebe:assignmentDefinition candidateGroups="underwriters" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_UwDecision" name="Underwriting decision?" default="Flow_UwReject">
      <bpmn:documentation>Exclusive; reject is the default.</bpmn:documentation>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_UwApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_UwCounter</bpmn:outgoing>
      <bpmn:outgoing>Flow_UwEscalate</bpmn:outgoing>
      <bpmn:outgoing>Flow_UwReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Committee" name="Credit committee review">
      <bpmn:documentation>L7 — senior committee decides high-value / borderline cases.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/credit-committee-review" />
        <zeebe:assignmentDefinition candidateGroups="credit-committee" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_UwEscalate</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Bnd_CommitteeSla" name="SLA 5 days passed" cancelActivity="false" attachedToRef="Task_Committee">
      <bpmn:documentation>L7 — non-interrupting: escalate without stopping the review.</bpmn:documentation>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Bnd_CommitteeSla_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_EscalateCCO" name="Escalate to chief credit officer">
      <bpmn:documentation>L7 — SLA breach escalation.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="escalate-cco" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_SlaEscalated" name="Escalated">
      <bpmn:documentation>Ends the escalation branch only.</bpmn:documentation>
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_CommitteeDecision" name="Committee approves?" default="Flow_CommReject">
      <bpmn:documentation>Exclusive; reject is the default.</bpmn:documentation>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_CommApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_CommReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_RejectMerge">
      <bpmn:documentation>Merge: every rejection route.</bpmn:documentation>
      <bpmn:incoming>Flow_IdUnresolved</bpmn:incoming>
      <bpmn:incoming>Flow_AutoReject</bpmn:incoming>
      <bpmn:incoming>Flow_RestructNo</bpmn:incoming>
      <bpmn:incoming>Flow_UwReject</bpmn:incoming>
      <bpmn:incoming>Flow_CommReject</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendRejection" name="Send rejection with reason codes">
      <bpmn:documentation>Adverse-action notice with reason codes.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Rejected" name="Application rejected">
      <bpmn:documentation>Terminal.</bpmn:documentation>
      <bpmn:incoming>Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_OfferMerge">
      <bpmn:documentation>Merge: auto-approved, underwriter-approved, committee-approved.</bpmn:documentation>
      <bpmn:incoming>Flow_AutoApprove</bpmn:incoming>
      <bpmn:incoming>Flow_UwApprove</bpmn:incoming>
      <bpmn:incoming>Flow_CommApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_GenerateOffer" name="Generate loan offer">
      <bpmn:documentation>Computes the EMI for the approved amount, rate and tenure (inline FEEL, no worker needed).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="=approvedAmount * monthlyRate / (1 - (1 + monthlyRate) ** (-tenureMonths))" resultVariable="emi" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sendTask id="Task_SendOffer" name="Send offer to applicant">
      <bpmn:documentation>Sends the offer letter with validity date.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-offer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_AwaitAcceptance" name="Await offer acceptance" messageRef="Msg_OfferAccepted">
      <bpmn:documentation>Waits for the applicant to accept.</bpmn:documentation>
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Bnd_OfferExpired" name="Offer validity (15 days) over" cancelActivity="true" attachedToRef="Task_AwaitAcceptance">
      <bpmn:documentation>L9 — interrupting timer.</bpmn:documentation>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Bnd_OfferExpired_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_OfferDeclined" name="Offer declined" cancelActivity="true" attachedToRef="Task_AwaitAcceptance">
      <bpmn:documentation>L9 — applicant refuses the offer.</bpmn:documentation>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Bnd_OfferDeclined_messageDef" messageRef="Msg_OfferDeclined" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_OfferExpired" name="Offer expired">
      <bpmn:documentation>Terminal.</bpmn:documentation>
      <bpmn:incoming>Flow_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OfferDeclined" name="Offer declined">
      <bpmn:documentation>Terminal.</bpmn:documentation>
      <bpmn:incoming>Flow_39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_SignMerge">
      <bpmn:documentation>Merge: first and repeated signature requests.</bpmn:documentation>
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:incoming>Flow_SignRetryYes</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendAgreement" name="Send agreement for e-signature">
      <bpmn:documentation>Sends the loan agreement to the e-sign provider.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-agreement" />
        <zeebe:ioMapping>
          <zeebe:output source="=if signAttempts = null then 1 else signAttempts + 1" target="signAttempts" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_AwaitSignature" name="Await signed agreement" messageRef="Msg_Signed">
      <bpmn:documentation>Waits for the signed agreement.</bpmn:documentation>
      <bpmn:incoming>Flow_42</bpmn:incoming>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Bnd_SignTimeout" name="Not signed in 5 days" cancelActivity="true" attachedToRef="Task_AwaitSignature">
      <bpmn:documentation>L11 — interrupting timer.</bpmn:documentation>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Bnd_SignTimeout_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_VerifySignature" name="Verify signature">
      <bpmn:documentation>Validates the e-signature certificate and signer identity.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-signature" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_SignValid" name="Signature valid?" default="Flow_SignBad">
      <bpmn:documentation>L11 — exclusive: valid, or mismatch (default).</bpmn:documentation>
      <bpmn:incoming>Flow_45</bpmn:incoming>
      <bpmn:outgoing>Flow_SignOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_SignBad</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_SignFailMerge">
      <bpmn:documentation>Merge: signature mismatch or not signed in time.</bpmn:documentation>
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:incoming>Flow_SignBad</bpmn:incoming>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_SignRetry" name="Fewer than 2 attempts?" default="Flow_SignRetryNo">
      <bpmn:documentation>L11 — bounded loop: 2 signature attempts.</bpmn:documentation>
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:outgoing>Flow_SignRetryYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_SignRetryNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OfferCancelled" name="Offer cancelled">
      <bpmn:documentation>Terminal: agreement never validly signed.</bpmn:documentation>
      <bpmn:incoming>Flow_SignRetryNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreateAccount" name="Create loan account">
      <bpmn:documentation>Opens the loan account and repayment schedule.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-loan-account" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SignOk</bpmn:incoming>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_AccountComp" name="Undo account" cancelActivity="true" attachedToRef="Task_CreateAccount">
      <bpmn:documentation>Compensation boundary for the loan account.</bpmn:documentation>
      <bpmn:compensateEventDefinition id="Bnd_AccountComp_compensateDef" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_CloseAccount" name="Reverse loan account" isForCompensation="true">
      <bpmn:documentation>Compensation handler: closes the account and cancels the schedule.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reverse-loan-account" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_AcctMerge">
      <bpmn:documentation>Merge: first payout and retry after the issue is fixed.</bpmn:documentation>
      <bpmn:incoming>Flow_47</bpmn:incoming>
      <bpmn:incoming>Flow_ResolvedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_48</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_VerifyBeneficiary" name="Verify beneficiary account">
      <bpmn:documentation>L12 — penny-drop / name match on the payout account.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="verify-beneficiary" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_48</bpmn:incoming>
      <bpmn:outgoing>Flow_49</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_AcctValid" name="Account valid?" default="Flow_AcctBad">
      <bpmn:documentation>L12 — exclusive: valid, or invalid (default).</bpmn:documentation>
      <bpmn:incoming>Flow_49</bpmn:incoming>
      <bpmn:outgoing>Flow_AcctOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_AcctBad</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Disburse" name="Disburse funds">
      <bpmn:documentation>Pays out through the payment gateway. Retries 3 times, then throws PAYMENT_FAILED.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="disburse-funds" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AcctOk</bpmn:incoming>
      <bpmn:outgoing>Flow_54</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_PaymentFailed" name="Payment failed" cancelActivity="true" attachedToRef="Task_Disburse">
      <bpmn:documentation>L12 — gateway error after all retries.</bpmn:documentation>
      <bpmn:outgoing>Flow_50</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Bnd_PaymentFailed_errorDef" errorRef="Err_PaymentFailed" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gw_HoldMerge">
      <bpmn:documentation>Merge: invalid account or failed payment.</bpmn:documentation>
      <bpmn:incoming>Flow_AcctBad</bpmn:incoming>
      <bpmn:incoming>Flow_50</bpmn:incoming>
      <bpmn:outgoing>Flow_51</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_HoldContact" name="Hold funds and contact applicant">
      <bpmn:documentation>L12 — funds held; operations obtains correct bank details.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/hold-funds-and-contact-applicant" />
        <zeebe:assignmentDefinition candidateGroups="operations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_51</bpmn:incoming>
      <bpmn:outgoing>Flow_52</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Resolved" name="Resolved?" default="Flow_ResolvedNo">
      <bpmn:documentation>L12 — exclusive: fixed (retry), or not (default).</bpmn:documentation>
      <bpmn:incoming>Flow_52</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolvedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ResolvedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Throw_ReverseAccount" name="Reverse loan account">
      <bpmn:documentation>L12 — compensation: undoes the loan account creation (and refunds the processing fee).</bpmn:documentation>
      <bpmn:incoming>Flow_ResolvedNo</bpmn:incoming>
      <bpmn:outgoing>Flow_53</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Throw_ReverseAccount_compensateDef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_DisbursementFailed" name="Disbursement failed">
      <bpmn:documentation>Terminal.</bpmn:documentation>
      <bpmn:incoming>Flow_53</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyDisbursed" name="Notify applicant of disbursement">
      <bpmn:documentation>Sends the disbursement advice and repayment schedule.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-disbursement" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_54</bpmn:incoming>
      <bpmn:outgoing>Flow_55</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Disbursed" name="Loan disbursed">
      <bpmn:documentation>Successful end.</bpmn:documentation>
      <bpmn:incoming>Flow_55</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Sub_Withdrawal" name="Withdrawal at any stage" triggeredByEvent="true">
      <bpmn:documentation>L10 — interrupting event sub-process: a withdrawal message cancels whatever is running.</bpmn:documentation>
      <bpmn:startEvent id="Start_Withdraw" name="Withdrawal requested">
        <bpmn:documentation>Interrupting message start.</bpmn:documentation>
        <bpmn:outgoing>Flow_W1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Start_Withdraw_messageDef" messageRef="Msg_Withdraw" />
      </bpmn:startEvent>
      <bpmn:intermediateThrowEvent id="Throw_Undo" name="Reverse fees and holds">
        <bpmn:documentation>Compensation throw: refunds the processing fee and reverses the loan account if they were completed.</bpmn:documentation>
        <bpmn:incoming>Flow_W1</bpmn:incoming>
        <bpmn:outgoing>Flow_W2</bpmn:outgoing>
        <bpmn:compensateEventDefinition id="Throw_Undo_compensateDef" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sendTask id="Task_ConfirmWithdrawal" name="Confirm withdrawal">
        <bpmn:documentation>Confirms closure to the applicant.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="confirm-withdrawal" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_W2</bpmn:incoming>
        <bpmn:outgoing>Flow_W3</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="End_Withdrawn" name="Withdrawn">
        <bpmn:documentation>Terminal.</bpmn:documentation>
        <bpmn:incoming>Flow_W3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_W1" sourceRef="Start_Withdraw" targetRef="Throw_Undo" />
      <bpmn:sequenceFlow id="Flow_W2" sourceRef="Throw_Undo" targetRef="Task_ConfirmWithdrawal" />
      <bpmn:sequenceFlow id="Flow_W3" sourceRef="Task_ConfirmWithdrawal" targetRef="End_Withdrawn" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Application" targetRef="Gw_DocsMerge" />
