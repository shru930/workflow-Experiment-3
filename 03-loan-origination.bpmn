    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SignBad" name="No" sourceRef="Gw_SignValid" targetRef="Gw_SignFailMerge" />
    <bpmn:sequenceFlow id="Flow_46" sourceRef="Gw_SignFailMerge" targetRef="Gw_SignRetry" />
