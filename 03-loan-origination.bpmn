    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_KYC" targetRef="Gw_KycMatch" />
    <bpmn:sequenceFlow id="Flow_KycYes" name="Yes" sourceRef="Gw_KycMatch" targetRef="Gw_KycMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kycMatch = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_KycNo" name="No" sourceRef="Gw_KycMatch" targetRef="Task_ManualKYC" />
