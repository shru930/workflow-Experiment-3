    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_FraudScreen" targetRef="Gw_VerifyJoin" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CreditScore" targetRef="Gw_CreditMerge" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Bnd_BureauDown" targetRef="Task_ManualCredit" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ManualCredit" targetRef="Gw_CreditMerge" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gw_CreditMerge" targetRef="Gw_VerifyJoin" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_VerifyIncome" targetRef="Gw_VerifyJoin" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gw_VerifyJoin" targetRef="Gw_VerifyOutcome" />
    <bpmn:sequenceFlow id="Flow_Flag" name="Compliance flag" sourceRef="Gw_VerifyOutcome" targetRef="Sub_Investigation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=complianceFlag = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IdUnresolved" name="Identity unresolved" sourceRef="Gw_VerifyOutcome" targetRef="Gw_RejectMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kycMatch = false and kycResolved != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AllClear" name="All clear" sourceRef="Gw_VerifyOutcome" targetRef="Gw_ScoreMerge" />
    <bpmn:sequenceFlow id="Flow_I4" sourceRef="Sub_Investigation" targetRef="Gw_ScoreMerge" />
    <bpmn:sequenceFlow id="Flow_I5" sourceRef="Bnd_Fraud" targetRef="Task_Freeze" />
    <bpmn:sequenceFlow id="Flow_I6" sourceRef="Task_Freeze" targetRef="End_Terminated" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gw_ScoreMerge" targetRef="Task_Score" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Score" targetRef="Gw_RiskDecision" />
    <bpmn:sequenceFlow id="Flow_AutoApprove" name="Auto-approve" sourceRef="Gw_RiskDecision" targetRef="Gw_OfferMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=risk.decision = "AUTO_APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AutoReject" name="Reject" sourceRef="Gw_RiskDecision" targetRef="Gw_RejectMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=risk.decision = "REJECT"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Counter" name="Counter-offer" sourceRef="Gw_RiskDecision" targetRef="Gw_CounterMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=risk.decision = "COUNTER_OFFER"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Manual" name="Manual review" sourceRef="Gw_RiskDecision" targetRef="Gw_ChecksSplit" />
    <bpmn:sequenceFlow id="Flow_CounterMerged" sourceRef="Gw_CounterMerge" targetRef="Gw_RestructuredBefore" />
    <bpmn:sequenceFlow id="Flow_RestructYes" name="No" sourceRef="Gw_RestructuredBefore" targetRef="Task_Restructure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=restructured != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RestructNo" name="Yes" sourceRef="Gw_RestructuredBefore" targetRef="Gw_RejectMerge" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Restructure" targetRef="Gw_ScoreMerge" />
    <bpmn:sequenceFlow id="Flow_ChkCollateral" name="Secured loan" sourceRef="Gw_ChecksSplit" targetRef="Task_Collateral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=secured = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ChkGuarantor" name="Has guarantor" sourceRef="Gw_ChecksSplit" targetRef="Task_Guarantor">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hasGuarantor = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ChkEDD" name="Above threshold" sourceRef="Gw_ChecksSplit" targetRef="Task_EDD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loanAmount &gt; eddThreshold</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ChkNone" name="None" sourceRef="Gw_ChecksSplit" targetRef="Gw_ChecksJoin" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Collateral" targetRef="Gw_ChecksJoin" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Guarantor" targetRef="Gw_ChecksJoin" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_EDD" targetRef="Gw_ChecksJoin" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gw_ChecksJoin" targetRef="Task_Underwrite" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_Underwrite" targetRef="Gw_UwDecision" />
    <bpmn:sequenceFlow id="Flow_UwApprove" name="Approve" sourceRef="Gw_UwDecision" targetRef="Gw_OfferMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=uwDecision = "APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_UwCounter" name="Counter-offer" sourceRef="Gw_UwDecision" targetRef="Gw_CounterMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=uwDecision = "COUNTER_OFFER"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_UwEscalate" name="Escalate" sourceRef="Gw_UwDecision" targetRef="Task_Committee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=uwDecision = "ESCALATE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_UwReject" name="Reject" sourceRef="Gw_UwDecision" targetRef="Gw_RejectMerge" />
