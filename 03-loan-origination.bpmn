    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_EscalateCCO" targetRef="End_SlaEscalated" />
    <bpmn:sequenceFlow id="Flow_CommApprove" name="Yes" sourceRef="Gw_CommitteeDecision" targetRef="Gw_OfferMerge">
