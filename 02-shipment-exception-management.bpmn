<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_shipment-exception-management" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_shipment-exception-management">
    <bpmn:participant id="Participant_Main" name="Courier Company" processRef="shipment-exception-management" />
    <bpmn:participant id="Participant_Shipper" name="Shipper / Customer">
      <bpmn:documentation>External party that books, pays, corrects data and may cancel.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_Recipient" name="Recipient">
      <bpmn:documentation>External party who receives (or refuses) the parcel.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:messageFlow id="MsgFlow_Booking" name="Booking" sourceRef="Participant_Shipper" targetRef="Start_Booking" />
    <bpmn:messageFlow id="MsgFlow_CorrReq" name="Errors" sourceRef="Task_RequestCorrection" targetRef="Participant_Shipper" />
    <bpmn:messageFlow id="MsgFlow_Corr" name="Corrected booking" sourceRef="Participant_Shipper" targetRef="Task_AwaitCorrection" />
    <bpmn:messageFlow id="MsgFlow_Tracking" name="Tracking link" sourceRef="Task_TrackingUpdate" targetRef="Participant_Shipper" />
    <bpmn:messageFlow id="MsgFlow_Cancel" name="Cancel" sourceRef="Participant_Shipper" targetRef="Bnd_Cancel" />
    <bpmn:messageFlow id="MsgFlow_DocsReq" name="Document request" sourceRef="Task_RequestDocs" targetRef="Participant_Shipper" />
    <bpmn:messageFlow id="MsgFlow_Docs" name="Documents" sourceRef="Participant_Shipper" targetRef="Task_AwaitDocs" />
    <bpmn:messageFlow id="MsgFlow_Window" name="Delivery window" sourceRef="Task_OutForDelivery" targetRef="Participant_Recipient" />
    <bpmn:messageFlow id="MsgFlow_AddrReq" name="Address query" sourceRef="Task_ContactRecipient" targetRef="Participant_Recipient" />
    <bpmn:messageFlow id="MsgFlow_Addr" name="Address" sourceRef="Participant_Recipient" targetRef="Task_AwaitAddress" />
  </bpmn:collaboration>
  <bpmn:process id="shipment-exception-management" name="Logistics and Shipment Exception Management" isExecutable="true">
    <bpmn:documentation>Full shipment life cycle from booking to closure, with every exception detected and resolved inside the model: booking errors, failed pickup, scan failures, damage, loss, transit delays, customs holds, failed delivery attempts, refusals, address problems and cancellation after dispatch (E1–E10).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Main">
      <bpmn:lane id="Lane_ControlTower" name="Control Tower / Dispatcher">
        <bpmn:documentation>Booking, payment, dispatch planning, customer communication and shipment closure.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_Booking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BookingMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BookingValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_CorrectionTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BookingLapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_PaymentComp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefundCharges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SchedulePickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DispatchSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TrackingUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BookLinehaul</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DispatchJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecallParcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_RefundCancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_DocsTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DeliveredMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseShipment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Delivered</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hub" name="Hub / Warehouse">
        <bpmn:documentation>Sorting, line-haul between hubs, customs filing, depot holds and returns.</bpmn:documentation>
        <bpmn:flowNodeRef>Gw_TransitMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Transit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_Damaged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_NoScan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_International</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CustomsMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FileCustoms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CustomsCleared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_CustomsDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HoldDepot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DepotEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Collected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_HoldExpired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ReturnMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnToSender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Returned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pickup" name="Pickup Agent">
        <bpmn:documentation>Collects the parcel from the shipper.</bpmn:documentation>
        <bpmn:flowNodeRef>Gw_PickupMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectParcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PickupOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PickupRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_NextPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_RefundBooking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BookingCancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Delivery" name="Delivery Agent">
        <bpmn:documentation>Last-mile delivery to the recipient.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_OutForDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AttemptMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttemptDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DeliveryOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AttemptsLeft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_NextDay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContactRecipient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwaitAddress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_AddressTimeout</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Claims" name="Claims Department">
        <bpmn:documentation>Damage inspection, insurance claims and lost-parcel tracing.</bpmn:documentation>
        <bpmn:flowNodeRef>Gw_DamageMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectDamage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Insured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SettleClaim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ClaimSettled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformUninsured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_DamageClosed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TraceParcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_TraceTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeclareLost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Lost</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Booking" name="Booking received">
      <bpmn:documentation>Message start: the shipper books a shipment on the portal / API.</bpmn:documentation>
      <bpmn:outgoing>Flow_B1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Booking_messageDef" messageRef="Msg_Booking" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_BookingMerge">
      <bpmn:documentation>Merge: original and corrected bookings.</bpmn:documentation>
      <bpmn:incoming>Flow_B1</bpmn:incoming>
      <bpmn:incoming>Flow_Corrected</bpmn:incoming>
      <bpmn:outgoing>Flow_B2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_ValidateBooking" name="Validate booking and calculate charges">
      <bpmn:documentation>Rules check address format and serviceability, declared weight and dimensions against the service level, prohibited items, and price the shipment.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-and-price-booking" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B2</bpmn:incoming>
      <bpmn:outgoing>Flow_B3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_BookingValid" name="Booking valid?" default="Flow_BookingBad">
      <bpmn:documentation>E2 (at booking) — exclusive: valid, or invalid (default).</bpmn:documentation>
      <bpmn:incoming>Flow_B3</bpmn:incoming>
      <bpmn:outgoing>Flow_BookingOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_BookingBad</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestCorrection" name="Request booking correction">
      <bpmn:documentation>E2 — returns the validation errors (bad address, weight mismatch) to the shipper.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-booking-correction" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BookingBad</bpmn:incoming>
      <bpmn:outgoing>Flow_B4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_AwaitCorrection" name="Await corrected booking" messageRef="Msg_CorrectedBooking">
      <bpmn:documentation>Waits for the corrected booking.</bpmn:documentation>
      <bpmn:incoming>Flow_B4</bpmn:incoming>
      <bpmn:outgoing>Flow_Corrected</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Bnd_CorrectionTimeout" name="48 h without correction" cancelActivity="true" attachedToRef="Task_AwaitCorrection">
      <bpmn:documentation>E2 — interrupting timer: the booking is dropped.</bpmn:documentation>
      <bpmn:outgoing>Flow_B5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Bnd_CorrectionTimeout_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_BookingLapsed" name="Booking lapsed">
      <bpmn:documentation>Terminal: invalid booking never corrected.</bpmn:documentation>
      <bpmn:incoming>Flow_B5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_TakePayment" name="Confirm booking and take payment">
      <bpmn:documentation>Charges the shipper (or posts to the account) and issues the tracking number.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="take-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BookingOk</bpmn:incoming>
      <bpmn:outgoing>Flow_B6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Bnd_PaymentComp" name="Undo charge" cancelActivity="true" attachedToRef="Task_TakePayment">
      <bpmn:documentation>Compensation boundary for the payment.</bpmn:documentation>
      <bpmn:compensateEventDefinition id="Bnd_PaymentComp_compensateDef" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_RefundCharges" name="Refund charges minus fee" isForCompensation="true">
      <bpmn:documentation>Compensation handler: refunds the shipping charge less the cancellation fee.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="refund-charges" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SchedulePickup" name="Schedule pickup and assign driver">
      <bpmn:documentation>Plans the pickup run and assigns the nearest available pickup agent.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="schedule-pickup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_B6</bpmn:incoming>
      <bpmn:outgoing>Flow_B7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_PickupMerge">
      <bpmn:documentation>Merge: first attempt and rescheduled attempts.</bpmn:documentation>
      <bpmn:incoming>Flow_B7</bpmn:incoming>
      <bpmn:incoming>Flow_P3</bpmn:incoming>
      <bpmn:outgoing>Flow_P1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CollectParcel" name="Collect and scan parcel">
      <bpmn:documentation>Agent collects the parcel, checks packaging and scans it into the network, or records why pickup failed (shipper absent, parcel not ready).</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/collect-and-scan-parcel" />
        <zeebe:assignmentDefinition candidateGroups="pickup-agents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_P5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_PickupOk" name="Parcel collected?" default="Flow_PickupFailed">
      <bpmn:documentation>E1 — exclusive: collected, or pickup failed (default).</bpmn:documentation>
      <bpmn:incoming>Flow_P5</bpmn:incoming>
      <bpmn:outgoing>Flow_PickedUp</bpmn:outgoing>
      <bpmn:outgoing>Flow_PickupFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_PickupRetry" name="Reschedules left?" default="Flow_PickupNo">
      <bpmn:documentation>E1 — bounded loop: at most 2 reschedules.</bpmn:documentation>
      <bpmn:incoming>Flow_PickupFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_PickupYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_PickupNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Catch_NextPickup" name="Next pickup slot">
      <bpmn:documentation>E1 — waits for the rescheduled slot (next working day) and counts the attempt.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if pickupReschedules = null then 1 else pickupReschedules + 1" target="pickupReschedules" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PickupYes</bpmn:incoming>
      <bpmn:outgoing>Flow_P3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Catch_NextPickup_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Throw_RefundBooking" name="Refund minus fee">
      <bpmn:documentation>E1 — compensation: triggers Refund charges minus fee for the payment taken at booking.</bpmn:documentation>
      <bpmn:incoming>Flow_PickupNo</bpmn:incoming>
      <bpmn:outgoing>Flow_P4</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Throw_RefundBooking_compensateDef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_BookingCancelled" name="Booking cancelled">
      <bpmn:documentation>Terminal: parcel never collected; cancellation fee charged.</bpmn:documentation>
      <bpmn:incoming>Flow_P4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gw_DispatchSplit">
      <bpmn:documentation>Parallel split: customer update and line-haul booking are independent.</bpmn:documentation>
      <bpmn:incoming>Flow_PickedUp</bpmn:incoming>
      <bpmn:outgoing>Flow_D1</bpmn:outgoing>
      <bpmn:outgoing>Flow_D2</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Task_TrackingUpdate" name="Send tracking update to shipper">
      <bpmn:documentation>Tells the shipper the parcel is collected, with the tracking link.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-tracking-update" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_D1</bpmn:incoming>
      <bpmn:outgoing>Flow_D3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_BookLinehaul" name="Plan route and book line-haul">
      <bpmn:documentation>Computes the hub legs (remainingLegs) and books capacity on each line-haul.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="plan-route" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_D2</bpmn:incoming>
      <bpmn:outgoing>Flow_D4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_DispatchJoin">
      <bpmn:documentation>Parallel join: both must finish before the parcel moves.</bpmn:documentation>
      <bpmn:incoming>Flow_D3</bpmn:incoming>
      <bpmn:incoming>Flow_D4</bpmn:incoming>
      <bpmn:outgoing>Flow_D5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gw_TransitMerge">
      <bpmn:documentation>Merge: normal dispatch and resumption after a successful trace.</bpmn:documentation>
      <bpmn:incoming>Flow_D5</bpmn:incoming>
      <bpmn:incoming>Flow_Found</bpmn:incoming>
      <bpmn:outgoing>Flow_T0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_Transit" name="Hub sorting and line-haul (per leg)">
      <bpmn:documentation>Multi-instance (sequential) embedded sub-process: one instance per remaining hub leg.</bpmn:documentation>
      <bpmn:incoming>Flow_T0</bpmn:incoming>
      <bpmn:outgoing>Flow_T20</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=remainingLegs" inputElement="leg" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="Start_Leg" name="Leg started">
        <bpmn:documentation>Blank start of one leg.</bpmn:documentation>
        <bpmn:outgoing>Flow_T1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_SortScan" name="Sort and scan at hub">
        <bpmn:documentation>Automated sorter scans the parcel (barcode + damage camera) and routes it. Throws SCAN_FAILED when the scanner is offline or the data does not match.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="sort-and-scan" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_T1</bpmn:incoming>
        <bpmn:outgoing>Flow_T2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="Bnd_ScanFailed" name="Scan failed" cancelActivity="true" attachedToRef="Task_SortScan">
        <bpmn:documentation>E9 — scanner offline or system mismatch.</bpmn:documentation>
        <bpmn:outgoing>Flow_T3</bpmn:outgoing>
        <bpmn:errorEventDefinition id="Bnd_ScanFailed_errorDef" errorRef="Err_ScanFailed" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="Task_ManualScan" name="Record scan manually">
        <bpmn:documentation>E9 — hub supervisor records the scan by hand.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition externalReference="/forms/record-scan-manually" />
          <zeebe:assignmentDefinition candidateGroups="hub-supervisors" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_T3</bpmn:incoming>
        <bpmn:outgoing>Flow_T4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Task_Reconcile" name="Reconcile scan records">
        <bpmn:documentation>E9 — reconciles the manual record with tracking once systems are back.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reconcile-scans" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_T4</bpmn:incoming>
        <bpmn:outgoing>Flow_T5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gw_ScanMerge">
        <bpmn:documentation>Merge: normal or manual scan.</bpmn:documentation>
        <bpmn:incoming>Flow_T2</bpmn:incoming>
        <bpmn:incoming>Flow_T5</bpmn:incoming>
        <bpmn:outgoing>Flow_T6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gw_Intact" name="Parcel intact?" default="Flow_IntactNo">
        <bpmn:documentation>E3 — exclusive: intact, or damaged (default).</bpmn:documentation>
        <bpmn:incoming>Flow_T6</bpmn:incoming>
        <bpmn:outgoing>Flow_IntactYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_IntactNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_DamageFound" name="Damage found">
        <bpmn:documentation>E3 — error end: throws PARCEL_DAMAGED to the sub-process boundary.</bpmn:documentation>
        <bpmn:incoming>Flow_IntactNo</bpmn:incoming>
        <bpmn:errorEventDefinition id="End_DamageFound_errorDef" errorRef="Err_Damaged" />
      </bpmn:endEvent>
      <bpmn:serviceTask id="Task_Dispatch" name="Load and dispatch to next hub">
        <bpmn:documentation>Loads the parcel on the booked line-haul and records departure.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="dispatch-linehaul" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_IntactYes</bpmn:incoming>
        <bpmn:outgoing>Flow_T7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gw_WaitMerge">
        <bpmn:documentation>Merge: back to waiting after a delay is handled.</bpmn:documentation>
        <bpmn:incoming>Flow_T7</bpmn:incoming>
        <bpmn:incoming>Flow_T19</bpmn:incoming>
        <bpmn:outgoing>Flow_T8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:eventBasedGateway id="Gw_TransitEvent" name="Next transit event?">
        <bpmn:documentation>Event-based gateway: arrival scan, a reported delay, or the ETA running out — whichever comes first.</bpmn:documentation>
        <bpmn:incoming>Flow_T8</bpmn:incoming>
        <bpmn:outgoing>Flow_T9</bpmn:outgoing>
        <bpmn:outgoing>Flow_T10</bpmn:outgoing>
        <bpmn:outgoing>Flow_T11</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="Catch_Arrived" name="Arrival scan">
        <bpmn:documentation>Parcel scanned in at the next hub.</bpmn:documentation>
        <bpmn:incoming>Flow_T9</bpmn:incoming>
        <bpmn:outgoing>Flow_T12</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Catch_Arrived_messageDef" messageRef="Msg_Arrived" />
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="End_LegDone" name="Leg completed">
        <bpmn:documentation>One leg done.</bpmn:documentation>
        <bpmn:incoming>Flow_T12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="Catch_DelayReported" name="Delay reported">
        <bpmn:documentation>E5 — weather, strike, breakdown or hub overload reported by the driver or hub.</bpmn:documentation>
        <bpmn:incoming>Flow_T10</bpmn:incoming>
        <bpmn:outgoing>Flow_T13</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Catch_DelayReported_messageDef" messageRef="Msg_Delay" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="Catch_EtaExceeded" name="ETA exceeded">
        <bpmn:documentation>E5 — nothing heard and the leg ETA has passed.</bpmn:documentation>
        <bpmn:incoming>Flow_T11</bpmn:incoming>
        <bpmn:outgoing>Flow_T14</bpmn:outgoing>
        <bpmn:timerEventDefinition id="Catch_EtaExceeded_timerDef">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT12H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gw_DelayMerge">
        <bpmn:documentation>Merge: both delay triggers handled the same way.</bpmn:documentation>
        <bpmn:incoming>Flow_T13</bpmn:incoming>
        <bpmn:incoming>Flow_T14</bpmn:incoming>
        <bpmn:outgoing>Flow_T15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:inclusiveGateway id="Gw_DelaySplit" name="Delay response?">
        <bpmn:documentation>E5 — inclusive split: the customer is always told; reroute and / or a replacement vehicle are added only when needed.</bpmn:documentation>
        <bpmn:incoming>Flow_T15</bpmn:incoming>
        <bpmn:outgoing>Flow_DelayNotify</bpmn:outgoing>
        <bpmn:outgoing>Flow_DelayReroute</bpmn:outgoing>
        <bpmn:outgoing>Flow_DelayVehicle</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:sendTask id="Task_NotifyEta" name="Notify shipper of new ETA">
        <bpmn:documentation>E5 — always done.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notify-new-eta" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_DelayNotify</bpmn:incoming>
        <bpmn:outgoing>Flow_T16</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:serviceTask id="Task_Reroute" name="Reroute shipment">
        <bpmn:documentation>E5 — when the route is blocked.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reroute-shipment" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_DelayReroute</bpmn:incoming>
        <bpmn:outgoing>Flow_T17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Task_AltVehicle" name="Assign alternate vehicle">
        <bpmn:documentation>E5 — when the vehicle broke down.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition externalReference="/forms/assign-alternate-vehicle" />
          <zeebe:assignmentDefinition candidateGroups="hub-staff" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_DelayVehicle</bpmn:incoming>
        <bpmn:outgoing>Flow_T18</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:inclusiveGateway id="Gw_DelayJoin">
        <bpmn:documentation>Inclusive join: waits only for the branches that were started.</bpmn:documentation>
        <bpmn:incoming>Flow_T16</bpmn:incoming>
        <bpmn:incoming>Flow_T17</bpmn:incoming>
        <bpmn:incoming>Flow_T18</bpmn:incoming>
        <bpmn:outgoing>Flow_T19</bpmn:outgoing>
      </bpmn:inclusiveGateway>
      <bpmn:sequenceFlow id="Flow_T1" sourceRef="Start_Leg" targetRef="Task_SortScan" />
      <bpmn:sequenceFlow id="Flow_T2" sourceRef="Task_SortScan" targetRef="Gw_ScanMerge" />
      <bpmn:sequenceFlow id="Flow_T3" sourceRef="Bnd_ScanFailed" targetRef="Task_ManualScan" />
      <bpmn:sequenceFlow id="Flow_T4" sourceRef="Task_ManualScan" targetRef="Task_Reconcile" />
      <bpmn:sequenceFlow id="Flow_T5" sourceRef="Task_Reconcile" targetRef="Gw_ScanMerge" />
      <bpmn:sequenceFlow id="Flow_T6" sourceRef="Gw_ScanMerge" targetRef="Gw_Intact" />
      <bpmn:sequenceFlow id="Flow_IntactYes" name="Yes" sourceRef="Gw_Intact" targetRef="Task_Dispatch">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=damaged != true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_IntactNo" name="No" sourceRef="Gw_Intact" targetRef="End_DamageFound" />
      <bpmn:sequenceFlow id="Flow_T7" sourceRef="Task_Dispatch" targetRef="Gw_WaitMerge" />
      <bpmn:sequenceFlow id="Flow_T8" sourceRef="Gw_WaitMerge" targetRef="Gw_TransitEvent" />
      <bpmn:sequenceFlow id="Flow_T9" sourceRef="Gw_TransitEvent" targetRef="Catch_Arrived" />
      <bpmn:sequenceFlow id="Flow_T10" sourceRef="Gw_TransitEvent" targetRef="Catch_DelayReported" />
      <bpmn:sequenceFlow id="Flow_T11" sourceRef="Gw_TransitEvent" targetRef="Catch_EtaExceeded" />
      <bpmn:sequenceFlow id="Flow_T12" sourceRef="Catch_Arrived" targetRef="End_LegDone" />
      <bpmn:sequenceFlow id="Flow_T13" sourceRef="Catch_DelayReported" targetRef="Gw_DelayMerge" />
      <bpmn:sequenceFlow id="Flow_T14" sourceRef="Catch_EtaExceeded" targetRef="Gw_DelayMerge" />
      <bpmn:sequenceFlow id="Flow_T15" sourceRef="Gw_DelayMerge" targetRef="Gw_DelaySplit" />
      <bpmn:sequenceFlow id="Flow_DelayNotify" name="Always" sourceRef="Gw_DelaySplit" targetRef="Task_NotifyEta">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_DelayReroute" name="Route blocked" sourceRef="Gw_DelaySplit" targetRef="Task_Reroute">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=routeBlocked = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_DelayVehicle" name="Vehicle down" sourceRef="Gw_DelaySplit" targetRef="Task_AltVehicle">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=vehicleDown = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_T16" sourceRef="Task_NotifyEta" targetRef="Gw_DelayJoin" />
      <bpmn:sequenceFlow id="Flow_T17" sourceRef="Task_Reroute" targetRef="Gw_DelayJoin" />
      <bpmn:sequenceFlow id="Flow_T18" sourceRef="Task_AltVehicle" targetRef="Gw_DelayJoin" />
      <bpmn:sequenceFlow id="Flow_T19" sourceRef="Gw_DelayJoin" targetRef="Gw_WaitMerge" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Bnd_Cancel" name="Cancellation received" cancelActivity="true" attachedToRef="Sub_Transit">
      <bpmn:documentation>E10 — interrupting message: the shipper cancels while the parcel is in transit.</bpmn:documentation>
      <bpmn:outgoing>Flow_Cancel</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Bnd_Cancel_messageDef" messageRef="Msg_Cancel" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Damaged" name="Parcel damaged" cancelActivity="true" attachedToRef="Sub_Transit">
      <bpmn:documentation>E3 — damage found at a hub.</bpmn:documentation>
      <bpmn:outgoing>Flow_Damaged</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Bnd_Damaged_errorDef" errorRef="Err_Damaged" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_NoScan" name="No scan for 48 h" cancelActivity="true" attachedToRef="Sub_Transit">
      <bpmn:documentation>E4 — interrupting timer: parcel has gone silent.</bpmn:documentation>
      <bpmn:outgoing>Flow_NoScan</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Bnd_NoScan_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_RecallParcel" name="Stop movement and recall parcel">
      <bpmn:documentation>E10 — dispatcher stops the parcel at the nearest hub and books it back to origin.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/stop-movement-and-recall-parcel" />
        <zeebe:assignmentDefinition candidateGroups="dispatchers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Throw_RefundCancel" name="Refund minus fee">
      <bpmn:documentation>E10 — compensation: refunds the charge less the cancellation fee.</bpmn:documentation>
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Throw_RefundCancel_compensateDef" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gw_International" name="International?" default="Flow_IntlNo">
      <bpmn:documentation>E6 — exclusive: only international shipments need customs.</bpmn:documentation>
      <bpmn:incoming>Flow_T20</bpmn:incoming>
      <bpmn:outgoing>Flow_IntlYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_IntlNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_CustomsMerge">
      <bpmn:documentation>Merge: first filing and re-filing with new documents.</bpmn:documentation>
      <bpmn:incoming>Flow_IntlYes</bpmn:incoming>
      <bpmn:incoming>Flow_X4</bpmn:incoming>
      <bpmn:outgoing>Flow_X1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_FileCustoms" name="File customs declaration">
      <bpmn:documentation>Submits the export / import declaration.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="file-customs" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_X1</bpmn:incoming>
      <bpmn:outgoing>Flow_X2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_CustomsCleared" name="Customs cleared?" default="Flow_ClearedNo">
      <bpmn:documentation>E6 — exclusive: cleared, or held for documents (default).</bpmn:documentation>
      <bpmn:incoming>Flow_X2</bpmn:incoming>
      <bpmn:outgoing>Flow_ClearedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ClearedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestDocs" name="Request documents from shipper">
      <bpmn:documentation>E6 — asks for the missing invoice, permit or HS-code details.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="request-customs-documents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClearedNo</bpmn:incoming>
      <bpmn:outgoing>Flow_X3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_AwaitDocs" name="Await customs documents" messageRef="Msg_CustomsDocs">
      <bpmn:documentation>E6 — waits for the shipper.</bpmn:documentation>
      <bpmn:incoming>Flow_X3</bpmn:incoming>
      <bpmn:outgoing>Flow_X4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Bnd_DocsTimeout" name="5 days, no documents" cancelActivity="true" attachedToRef="Task_AwaitDocs">
      <bpmn:documentation>E6 — interrupting timer: parcel goes back to origin.</bpmn:documentation>
      <bpmn:outgoing>Flow_X5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Bnd_DocsTimeout_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gw_CustomsDone">
      <bpmn:documentation>Merge: domestic, or international and cleared.</bpmn:documentation>
      <bpmn:incoming>Flow_IntlNo</bpmn:incoming>
      <bpmn:incoming>Flow_ClearedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_X6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_OutForDelivery" name="Send out for delivery and notify recipient">
      <bpmn:documentation>Assigns the parcel to a delivery run and sends the recipient the delivery window.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-recipient" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_X6</bpmn:incoming>
      <bpmn:outgoing>Flow_V1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gw_AttemptMerge">
      <bpmn:documentation>Merge: first attempt, re-attempts, corrected address.</bpmn:documentation>
      <bpmn:incoming>Flow_V1</bpmn:incoming>
      <bpmn:incoming>Flow_V4</bpmn:incoming>
      <bpmn:incoming>Flow_AddrOk</bpmn:incoming>
      <bpmn:outgoing>Flow_V2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AttemptDelivery" name="Attempt delivery and capture POD">
      <bpmn:documentation>Agent hands over the parcel, collects COD if due, and captures signature / photo as proof of delivery.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/attempt-delivery-and-capture-pod" />
        <zeebe:assignmentDefinition candidateGroups="delivery-agents" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_V2</bpmn:incoming>
      <bpmn:outgoing>Flow_V3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_DeliveryOutcome" name="Delivery outcome?" default="Flow_NotHome">
      <bpmn:documentation>Exclusive five-way outcome. "Not at home" is the default because it is the safe, retryable case.</bpmn:documentation>
      <bpmn:incoming>Flow_V3</bpmn:incoming>
      <bpmn:outgoing>Flow_Delivered</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotHome</bpmn:outgoing>
      <bpmn:outgoing>Flow_WrongAddr</bpmn:outgoing>
      <bpmn:outgoing>Flow_Refused</bpmn:outgoing>
      <bpmn:outgoing>Flow_DamagedAtDoor</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_AttemptsLeft" name="Fewer than 3 attempts?" default="Flow_AttemptNo">
      <bpmn:documentation>E7 — bounded loop: 3 delivery attempts.</bpmn:documentation>
      <bpmn:incoming>Flow_NotHome</bpmn:incoming>
      <bpmn:outgoing>Flow_AttemptYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_AttemptNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Catch_NextDay" name="Next delivery day">
      <bpmn:documentation>E7 — waits for the next run and counts the attempt.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if deliveryAttempts = null then 1 else deliveryAttempts + 1" target="deliveryAttempts" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AttemptYes</bpmn:incoming>
      <bpmn:outgoing>Flow_V4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Catch_NextDay_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_ContactRecipient" name="Ask recipient for correct address">
      <bpmn:documentation>E2 (at doorstep) — contacts the recipient; an address change outside the zone carries a surcharge billed at closure.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="contact-recipient" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_WrongAddr</bpmn:incoming>
      <bpmn:outgoing>Flow_V5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_AwaitAddress" name="Await address details" messageRef="Msg_Address">
      <bpmn:documentation>E2 — waits for the recipient.</bpmn:documentation>
      <bpmn:incoming>Flow_V5</bpmn:incoming>
      <bpmn:outgoing>Flow_AddrOk</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Bnd_AddressTimeout" name="No reply in 2 days" cancelActivity="true" attachedToRef="Task_AwaitAddress">
      <bpmn:documentation>E2 — interrupting timer: return to sender.</bpmn:documentation>
      <bpmn:outgoing>Flow_V6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Bnd_AddressTimeout_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P2D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_HoldDepot" name="Hold at depot and notify recipient">
      <bpmn:documentation>E7 — parcel is held at the depot for self-collection.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hold-at-depot" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AttemptNo</bpmn:incoming>
      <bpmn:outgoing>Flow_V7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gw_DepotEvent" name="Collected?">
      <bpmn:documentation>Event-based gateway: collection or 7 days, whichever first.</bpmn:documentation>
      <bpmn:incoming>Flow_V7</bpmn:incoming>
      <bpmn:outgoing>Flow_V8</bpmn:outgoing>
      <bpmn:outgoing>Flow_V9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Collected" name="Recipient collects">
      <bpmn:documentation>E7 — recipient collects from the depot.</bpmn:documentation>
      <bpmn:incoming>Flow_V8</bpmn:incoming>
      <bpmn:outgoing>Flow_V10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Collected_messageDef" messageRef="Msg_Collected" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_HoldExpired" name="7 days uncollected">
      <bpmn:documentation>E7 — hold period over.</bpmn:documentation>
      <bpmn:incoming>Flow_V9</bpmn:incoming>
      <bpmn:outgoing>Flow_V11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Catch_HoldExpired_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_DeliveredMerge">
      <bpmn:documentation>Merge: delivered at the door or collected at the depot.</bpmn:documentation>
      <bpmn:incoming>Flow_Delivered</bpmn:incoming>
      <bpmn:incoming>Flow_V10</bpmn:incoming>
      <bpmn:outgoing>Flow_E1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CloseShipment" name="Close shipment and generate invoice">
      <bpmn:documentation>Closes tracking, applies any surcharges, issues the invoice / receipt.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-shipment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_E1</bpmn:incoming>
      <bpmn:outgoing>Flow_E2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Delivered" name="Shipment delivered">
      <bpmn:documentation>Successful end.</bpmn:documentation>
      <bpmn:incoming>Flow_E2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_ReturnMerge">
      <bpmn:documentation>Merge: every route that ends in return to sender.</bpmn:documentation>
      <bpmn:incoming>Flow_C3</bpmn:incoming>
      <bpmn:incoming>Flow_X5</bpmn:incoming>
      <bpmn:incoming>Flow_Refused</bpmn:incoming>
      <bpmn:incoming>Flow_V6</bpmn:incoming>
      <bpmn:incoming>Flow_V11</bpmn:incoming>
      <bpmn:outgoing>Flow_R1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReturnToSender" name="Return parcel to sender">
      <bpmn:documentation>Books the return movement, adjusts charges (return fee, COD reversal) and informs the shipper.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="return-to-sender" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_R1</bpmn:incoming>
      <bpmn:outgoing>Flow_R2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Returned" name="Returned to sender">
      <bpmn:documentation>Terminal: parcel returned.</bpmn:documentation>
      <bpmn:incoming>Flow_R2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_DamageMerge">
      <bpmn:documentation>Merge: damage found at a hub or at the door.</bpmn:documentation>
      <bpmn:incoming>Flow_Damaged</bpmn:incoming>
      <bpmn:incoming>Flow_DamagedAtDoor</bpmn:incoming>
      <bpmn:outgoing>Flow_K1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_InspectDamage" name="Inspect damage">
      <bpmn:documentation>E3 — claims officer inspects photos / parcel and records the damage.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/inspect-damage" />
        <zeebe:assignmentDefinition candidateGroups="claims" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_K1</bpmn:incoming>
      <bpmn:outgoing>Flow_K2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Insured" name="Insured?" default="Flow_InsuredNo">
      <bpmn:documentation>E3 — exclusive: insured, or not (default).</bpmn:documentation>
      <bpmn:incoming>Flow_K2</bpmn:incoming>
      <bpmn:outgoing>Flow_InsuredYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_InsuredNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SettleClaim" name="Settle claim (refund, replace or reship)">
      <bpmn:documentation>E3 — claim settled under the policy.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/settle-claim-refund-replace-or-reship" />
        <zeebe:assignmentDefinition candidateGroups="claims" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InsuredYes</bpmn:incoming>
      <bpmn:outgoing>Flow_K3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ClaimSettled" name="Claim settled">
      <bpmn:documentation>Terminal: damaged shipment closed with settlement.</bpmn:documentation>
      <bpmn:incoming>Flow_K3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_InformUninsured" name="Record damage and inform shipper">
      <bpmn:documentation>E3 — no cover; shipper informed.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="inform-damage" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InsuredNo</bpmn:incoming>
      <bpmn:outgoing>Flow_K4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_DamageClosed" name="Closed as damaged">
      <bpmn:documentation>Terminal: damaged, uninsured.</bpmn:documentation>
      <bpmn:incoming>Flow_K4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_TraceParcel" name="Trace parcel">
      <bpmn:documentation>E4 — tracing: last-scan hub search, CCTV, driver interview. Completing the task means the parcel was found.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition externalReference="/forms/trace-parcel" />
        <zeebe:assignmentDefinition candidateGroups="claims" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoScan</bpmn:incoming>
      <bpmn:outgoing>Flow_Found</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Bnd_TraceTimeout" name="Not found in 5 days" cancelActivity="true" attachedToRef="Task_TraceParcel">
      <bpmn:documentation>E4 — interrupting timer: declared lost.</bpmn:documentation>
      <bpmn:outgoing>Flow_L1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Bnd_TraceTimeout_timerDef">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_DeclareLost" name="Declare lost and pay compensation">
      <bpmn:documentation>E4 — compensation paid and shipper notified.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="declare-lost" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_L1</bpmn:incoming>
      <bpmn:outgoing>Flow_L2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Lost" name="Closed as lost">
      <bpmn:documentation>Terminal: parcel lost.</bpmn:documentation>
      <bpmn:incoming>Flow_L2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_B1" sourceRef="Start_Booking" targetRef="Gw_BookingMerge" />
    <bpmn:sequenceFlow id="Flow_B2" sourceRef="Gw_BookingMerge" targetRef="Task_ValidateBooking" />
    <bpmn:sequenceFlow id="Flow_B3" sourceRef="Task_ValidateBooking" targetRef="Gw_BookingValid" />
    <bpmn:sequenceFlow id="Flow_BookingOk" name="Valid" sourceRef="Gw_BookingValid" targetRef="Task_TakePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=bookingValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BookingBad" name="Invalid" sourceRef="Gw_BookingValid" targetRef="Task_RequestCorrection" />
    <bpmn:sequenceFlow id="Flow_B4" sourceRef="Task_RequestCorrection" targetRef="Task_AwaitCorrection" />
    <bpmn:sequenceFlow id="Flow_Corrected" sourceRef="Task_AwaitCorrection" targetRef="Gw_BookingMerge" />
    <bpmn:sequenceFlow id="Flow_B5" sourceRef="Bnd_CorrectionTimeout" targetRef="End_BookingLapsed" />
    <bpmn:sequenceFlow id="Flow_B6" sourceRef="Task_TakePayment" targetRef="Task_SchedulePickup" />
    <bpmn:sequenceFlow id="Flow_B7" sourceRef="Task_SchedulePickup" targetRef="Gw_PickupMerge" />
    <bpmn:sequenceFlow id="Flow_P1" sourceRef="Gw_PickupMerge" targetRef="Task_CollectParcel" />
    <bpmn:sequenceFlow id="Flow_PickupYes" name="Yes" sourceRef="Gw_PickupRetry" targetRef="Catch_NextPickup">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pickupReschedules = null or pickupReschedules &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PickupNo" name="No" sourceRef="Gw_PickupRetry" targetRef="Throw_RefundBooking" />
    <bpmn:sequenceFlow id="Flow_P3" sourceRef="Catch_NextPickup" targetRef="Gw_PickupMerge" />
    <bpmn:sequenceFlow id="Flow_P4" sourceRef="Throw_RefundBooking" targetRef="End_BookingCancelled" />
    <bpmn:sequenceFlow id="Flow_P5" sourceRef="Task_CollectParcel" targetRef="Gw_PickupOk" />
    <bpmn:sequenceFlow id="Flow_PickedUp" name="Yes" sourceRef="Gw_PickupOk" targetRef="Gw_DispatchSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pickedUp = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PickupFailed" name="No" sourceRef="Gw_PickupOk" targetRef="Gw_PickupRetry" />
    <bpmn:sequenceFlow id="Flow_D1" sourceRef="Gw_DispatchSplit" targetRef="Task_TrackingUpdate" />
    <bpmn:sequenceFlow id="Flow_D2" sourceRef="Gw_DispatchSplit" targetRef="Task_BookLinehaul" />
    <bpmn:sequenceFlow id="Flow_D3" sourceRef="Task_TrackingUpdate" targetRef="Gw_DispatchJoin" />
    <bpmn:sequenceFlow id="Flow_D4" sourceRef="Task_BookLinehaul" targetRef="Gw_DispatchJoin" />
    <bpmn:sequenceFlow id="Flow_D5" sourceRef="Gw_DispatchJoin" targetRef="Gw_TransitMerge" />
    <bpmn:sequenceFlow id="Flow_T0" sourceRef="Gw_TransitMerge" targetRef="Sub_Transit" />
    <bpmn:sequenceFlow id="Flow_T20" sourceRef="Sub_Transit" targetRef="Gw_International" />
    <bpmn:sequenceFlow id="Flow_Cancel" sourceRef="Bnd_Cancel" targetRef="Task_RecallParcel" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_RecallParcel" targetRef="Throw_RefundCancel" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Throw_RefundCancel" targetRef="Gw_ReturnMerge" />
    <bpmn:sequenceFlow id="Flow_Damaged" sourceRef="Bnd_Damaged" targetRef="Gw_DamageMerge" />
    <bpmn:sequenceFlow id="Flow_NoScan" sourceRef="Bnd_NoScan" targetRef="Task_TraceParcel" />
    <bpmn:sequenceFlow id="Flow_Found" sourceRef="Task_TraceParcel" targetRef="Gw_TransitMerge" />
    <bpmn:sequenceFlow id="Flow_L1" sourceRef="Bnd_TraceTimeout" targetRef="Task_DeclareLost" />
    <bpmn:sequenceFlow id="Flow_L2" sourceRef="Task_DeclareLost" targetRef="End_Lost" />
    <bpmn:sequenceFlow id="Flow_K1" sourceRef="Gw_DamageMerge" targetRef="Task_InspectDamage" />
    <bpmn:sequenceFlow id="Flow_K2" sourceRef="Task_InspectDamage" targetRef="Gw_Insured" />
    <bpmn:sequenceFlow id="Flow_InsuredYes" name="Yes" sourceRef="Gw_Insured" targetRef="Task_SettleClaim">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=insured = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InsuredNo" name="No" sourceRef="Gw_Insured" targetRef="Task_InformUninsured" />
    <bpmn:sequenceFlow id="Flow_K3" sourceRef="Task_SettleClaim" targetRef="End_ClaimSettled" />
    <bpmn:sequenceFlow id="Flow_K4" sourceRef="Task_InformUninsured" targetRef="End_DamageClosed" />
    <bpmn:sequenceFlow id="Flow_IntlYes" name="Yes" sourceRef="Gw_International" targetRef="Gw_CustomsMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=international = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IntlNo" name="No" sourceRef="Gw_International" targetRef="Gw_CustomsDone" />
    <bpmn:sequenceFlow id="Flow_X1" sourceRef="Gw_CustomsMerge" targetRef="Task_FileCustoms" />
    <bpmn:sequenceFlow id="Flow_X2" sourceRef="Task_FileCustoms" targetRef="Gw_CustomsCleared" />
    <bpmn:sequenceFlow id="Flow_ClearedYes" name="Yes" sourceRef="Gw_CustomsCleared" targetRef="Gw_CustomsDone">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=customsCleared = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ClearedNo" name="Held" sourceRef="Gw_CustomsCleared" targetRef="Task_RequestDocs" />
    <bpmn:sequenceFlow id="Flow_X3" sourceRef="Task_RequestDocs" targetRef="Task_AwaitDocs" />
    <bpmn:sequenceFlow id="Flow_X4" sourceRef="Task_AwaitDocs" targetRef="Gw_CustomsMerge" />
    <bpmn:sequenceFlow id="Flow_X5" sourceRef="Bnd_DocsTimeout" targetRef="Gw_ReturnMerge" />
    <bpmn:sequenceFlow id="Flow_X6" sourceRef="Gw_CustomsDone" targetRef="Task_OutForDelivery" />
    <bpmn:sequenceFlow id="Flow_V1" sourceRef="Task_OutForDelivery" targetRef="Gw_AttemptMerge" />
    <bpmn:sequenceFlow id="Flow_V2" sourceRef="Gw_AttemptMerge" targetRef="Task_AttemptDelivery" />
    <bpmn:sequenceFlow id="Flow_V3" sourceRef="Task_AttemptDelivery" targetRef="Gw_DeliveryOutcome" />
    <bpmn:sequenceFlow id="Flow_Delivered" name="Delivered" sourceRef="Gw_DeliveryOutcome" targetRef="Gw_DeliveredMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=outcome = "DELIVERED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotHome" name="Not at home" sourceRef="Gw_DeliveryOutcome" targetRef="Gw_AttemptsLeft" />
    <bpmn:sequenceFlow id="Flow_WrongAddr" name="Wrong address" sourceRef="Gw_DeliveryOutcome" targetRef="Task_ContactRecipient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=outcome = "BAD_ADDRESS"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Refused" name="Refused / COD failed" sourceRef="Gw_DeliveryOutcome" targetRef="Gw_ReturnMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=outcome = "REFUSED" or outcome = "COD_FAILED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DamagedAtDoor" name="Damaged" sourceRef="Gw_DeliveryOutcome" targetRef="Gw_DamageMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=outcome = "DAMAGED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AttemptYes" name="Yes" sourceRef="Gw_AttemptsLeft" targetRef="Catch_NextDay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=deliveryAttempts = null or deliveryAttempts &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AttemptNo" name="No" sourceRef="Gw_AttemptsLeft" targetRef="Task_HoldDepot" />
    <bpmn:sequenceFlow id="Flow_V4" sourceRef="Catch_NextDay" targetRef="Gw_AttemptMerge" />
    <bpmn:sequenceFlow id="Flow_V5" sourceRef="Task_ContactRecipient" targetRef="Task_AwaitAddress" />
    <bpmn:sequenceFlow id="Flow_AddrOk" sourceRef="Task_AwaitAddress" targetRef="Gw_AttemptMerge" />
    <bpmn:sequenceFlow id="Flow_V6" sourceRef="Bnd_AddressTimeout" targetRef="Gw_ReturnMerge" />
    <bpmn:sequenceFlow id="Flow_V7" sourceRef="Task_HoldDepot" targetRef="Gw_DepotEvent" />
    <bpmn:sequenceFlow id="Flow_V8" sourceRef="Gw_DepotEvent" targetRef="Catch_Collected" />
    <bpmn:sequenceFlow id="Flow_V9" sourceRef="Gw_DepotEvent" targetRef="Catch_HoldExpired" />
    <bpmn:sequenceFlow id="Flow_V10" sourceRef="Catch_Collected" targetRef="Gw_DeliveredMerge" />
    <bpmn:sequenceFlow id="Flow_V11" sourceRef="Catch_HoldExpired" targetRef="Gw_ReturnMerge" />
    <bpmn:sequenceFlow id="Flow_E1" sourceRef="Gw_DeliveredMerge" targetRef="Task_CloseShipment" />
    <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_CloseShipment" targetRef="End_Delivered" />
    <bpmn:sequenceFlow id="Flow_R1" sourceRef="Gw_ReturnMerge" targetRef="Task_ReturnToSender" />
    <bpmn:sequenceFlow id="Flow_R2" sourceRef="Task_ReturnToSender" targetRef="End_Returned" />
    <bpmn:association id="Assoc_Refund" associationDirection="One" sourceRef="Bnd_PaymentComp" targetRef="Task_RefundCharges" />
  </bpmn:process>
  <bpmn:message id="Msg_Booking" name="shipment-booked" />
  <bpmn:message id="Msg_CorrectedBooking" name="booking-corrected">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=bookingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Cancel" name="shipment-cancelled">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=trackingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Arrived" name="arrival-scan">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=trackingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Delay" name="delay-reported">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=trackingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_CustomsDocs" name="customs-documents">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=trackingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Collected" name="parcel-collected-at-depot">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=trackingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_Address" name="address-confirmed">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=trackingId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Err_ScanFailed" name="Scan failed" errorCode="SCAN_FAILED" />
  <bpmn:error id="Err_Damaged" name="Parcel damaged" errorCode="PARCEL_DAMAGED" />
